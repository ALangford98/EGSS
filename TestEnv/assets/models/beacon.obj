# Beacon -- a base, a post and a lamp head, each with its own material.
#
# The point of this file is the three `usemtl` lines. Each one starts a new
# submesh: a range of indices drawn with one material. All of it is a single
# vertex buffer, so the whole model is three draw calls and one upload, not
# three meshes.
#
# No `vn` lines, and no `s`, so smoothing is off -- the .obj default -- and
# the loader gives each face its own normal. A box should look like a box.

mtllib beacon.mtl
o Beacon

# --- Slate -------------------------------------------------------
v -0.8000 0.0000 -0.8000
v 0.8000 0.0000 -0.8000
v 0.8000 0.0000 0.8000
v -0.8000 0.0000 0.8000
v -0.8000 0.2500 -0.8000
v 0.8000 0.2500 -0.8000
v 0.8000 0.2500 0.8000
v -0.8000 0.2500 0.8000
usemtl Slate
f 1 4 3 2
f 5 6 7 8
f 1 2 6 5
f 3 4 8 7
f 4 1 5 8
f 2 3 7 6

# --- Brass -------------------------------------------------------
v -0.1500 0.2500 -0.1500
v 0.1500 0.2500 -0.1500
v 0.1500 0.2500 0.1500
v -0.1500 0.2500 0.1500
v -0.1500 1.4000 -0.1500
v 0.1500 1.4000 -0.1500
v 0.1500 1.4000 0.1500
v -0.1500 1.4000 0.1500
usemtl Brass
f 9 12 11 10
f 13 14 15 16
f 9 10 14 13
f 11 12 16 15
f 12 9 13 16
f 10 11 15 14

# --- Lamp --------------------------------------------------------
v -0.5000 1.4000 -0.5000
v 0.5000 1.4000 -0.5000
v 0.5000 1.4000 0.5000
v -0.5000 1.4000 0.5000
v -0.5000 1.9000 -0.5000
v 0.5000 1.9000 -0.5000
v 0.5000 1.9000 0.5000
v -0.5000 1.9000 0.5000
usemtl Lamp
f 17 20 19 18
f 21 22 23 24
f 17 18 22 21
f 19 20 24 23
f 20 17 21 24
f 18 19 23 22
