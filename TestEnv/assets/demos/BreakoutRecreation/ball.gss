// Recreates Breakout.h's ball: constant-velocity motion, reflecting off
// the world's walls and the paddle, using the same constants and the same
// collision order Breakout.h's own Step() uses (walls, then paddle).
//
// One deliberate difference: Breakout.h treats the bottom edge as "out of
// bounds" (lose a life, relaunch), which needs lives/score/game-over state
// this recreation doesn't have a way to show (no UI hook reaches a script
// today). This bounces off the bottom too, so the ball just keeps playing
// forever instead of ever being "lost".
//
// The second (and last) script graduated to compiled C++ -- see
// CompiledScriptRegistry.h. Rewritten the same way paddle.gss was: index
// access (`pos[0]`) instead of array destructuring, and explicit `: number`
// on every top-level let/const (a class member can't use C++'s `auto`).
// Reads the paddle's X via scene.findByTag("Paddle").getPosition()[0] --
// calling a transform getter on a *local* holding a found entity (not the
// `entity` parameter itself) needed one small transpiler fix, made
// alongside this: emitCall only ever recognized entity.getPosition() by
// checking the identifier was literally named "entity"; it now applies the
// same getter/setter mapping to any identifier, since GS::Entity::Get<T>()
// works the same regardless of which variable holds the handle.
const worldHalfWidth: number = 1.6;
const worldHalfHeight: number = 0.9;
const ballRadius: number = 0.028;
const ballStartSpeed: number = 1.1;
const paddleY: number = -0.75;
const paddleFullWidth: number = 0.36;
const paddleFullHeight: number = 0.045;

let vx: number = ballStartSpeed * 0.45;
let vy: number = ballStartSpeed;

function OnUpdate(dt: number) {
    const pos = entity.getPosition();
    let x: number = pos[0];
    let y: number = pos[1];
    const z = pos[2];

    x += vx * dt;
    y += vy * dt;

    // --- Walls, same order and same snap-back-then-reflect shape as
    // Breakout.h's Step(). ---------------------------------------------
    if (x - ballRadius < -worldHalfWidth) {
        x = -worldHalfWidth + ballRadius;
        vx = Math.abs(vx);
    } else if (x + ballRadius > worldHalfWidth) {
        x = worldHalfWidth - ballRadius;
        vx = -Math.abs(vx);
    }

    if (y + ballRadius > worldHalfHeight) {
        y = worldHalfHeight - ballRadius;
        vy = -Math.abs(vy);
    }

    // Not in Breakout.h (there the floor means "lost") -- see the file
    // comment above for why this recreation bounces here instead.
    if (y - ballRadius < -worldHalfHeight) {
        y = -worldHalfHeight + ballRadius;
        vy = Math.abs(vy);
    }

    // --- Paddle collision, same box-overlap test as Breakout.h's
    // file-scope Overlaps(), same steer-by-hit-offset angling. -----------
    const paddle = scene.findByTag("Paddle");
    const paddleX = paddle ? paddle.getPosition()[0] : 0;

    const overlapsX = Math.abs(x - paddleX) * 2 < (ballRadius * 2 + paddleFullWidth);
    const overlapsY = Math.abs(y - paddleY) * 2 < (ballRadius * 2 + paddleFullHeight);

    if (vy < 0 && overlapsX && overlapsY) {
        vy = Math.abs(vy);

        const offset = (x - paddleX) / (paddleFullWidth * 0.5);
        vx = offset * ballStartSpeed;
    }

    entity.setPosition(x, y, z);
}
