# Dirs
.vs/
bin/
bin-int/
__pycache__/

# Claude Code worktrees. These are real git worktrees living inside the tree,
# so each has a .git file of its own and `git add .` reports them as embedded
# repositories and stages them as gitlinks. Ignoring the directory rather than
# all of .claude/, so settings there stay trackable.
.claude/worktrees/

# files
*.user

# premake-generated project files (regenerate with BuildProject.sh / .bat)
/Makefile
/GS/Makefile
/GS/vendor/Makefile
/GS/vendor/*.make
/GS/vendor/Glad/Makefile
/TestEnv/Makefile
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# generated by: bear -- make config=debug
compile_commands.json

# Runtime-generated world/planet data (TestEnv/src/OpenWorld.h,
# TestEnv/src/SolarSystem.h). Written relative to wherever the binary runs
# from -- never source, and 30MB+ once a planet has real terrain.
/openworld.chunks
/planet-*.edits
/planet-*.site